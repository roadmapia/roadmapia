{
  "name": "learnai",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "css:build": "postcss static/css/src/input.css -o static/css/tailwind.css && npm run css:combine",
    "css:watch": "postcss static/css/src/input.css -o static/css/tailwind.css --watch",
    "css:combine": "node -e \"const fs=require('fs');fs.writeFileSync('static/css/app.css', fs.readFileSync('static/css/tailwind.css','utf8')+fs.readFileSync('static/css/style.min.css','utf8'))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.0"
  }
}
